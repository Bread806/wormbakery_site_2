---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { WORKS, getCategoryLabel } from '../data/works';

// 只顯示指定的 6 部作品
const DISPLAY_IDS = [19, 10, 21, 22, 25, 26, 18, 20, 27];
const displayWorks = WORKS.filter((w) => DISPLAY_IDS.includes(w.id));
---

<BaseLayout title="各式作品" description="卡蚯蚓的委託作品集。">
  <Navigation />

  <main class="pt-20 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- 頁面標題 -->
      <h1 class="text-5xl font-mono font-black text-center mb-12 acid-chroma">各式作品</h1>

      <!-- 作品清單 -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {displayWorks.map((work) => (
          <article
            class="work-card card-retro overflow-hidden cursor-pointer"
            data-work-id={work.id}
          >
            <!-- 封面：統一 4:3 比例 -->
            <div class="relative aspect-[4/3] overflow-hidden border-b-3 border-[var(--fg)]">
              {work.image ? (
                <img src={work.image} alt={work.title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
              ) : (
                <div class="absolute inset-0 bg-[var(--fg)] flex items-center justify-center">
                  <span class="text-[var(--bg)] font-barcode text-2xl">NO COVER</span>
                </div>
              )}
            </div>

            <!-- 內容 -->
            <div class="p-5">
              <h3 class="text-xl font-bold mb-2 line-clamp-2">{work.title}</h3>
              <p class="text-sm opacity-80 mb-3 line-clamp-2">{work.description}</p>
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono px-2 py-1 border-2 border-[var(--fg)]">
                  {getCategoryLabel(work.category)}
                </span>
                <span class="font-barcode text-xl opacity-60">#{String(work.id).padStart(3, '0')}</span>
              </div>
              <!-- 聲波裝飾（hover 時顯示） -->
              <div class="mt-4 waveform opacity-0 group-hover:opacity-100 transition-opacity h-6">
                {Array.from({ length: 12 }).map((_, i) => (
                  <div class="waveform-bar" style={`animation-delay: ${i * 0.05}s`}></div>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <!-- 作品面板容器（動態產生多個可拖曳面板） -->
  <div id="work-panels"></div>

  <Footer />

  <script>
    import { WORKS, getCategoryLabel } from '../data/works';

const DISPLAY_IDS = [19, 10, 21, 22, 25, 26, 18, 20, 27];
    const works = WORKS.filter((w) => DISPLAY_IDS.includes(w.id));
    const panelsContainer = document.getElementById('work-panels');

    // z-index 管理器：每次開新面板或點擊面板時遞增，確保最上層
    let zIndexCounter = 100;
    // 面板偏移計數器：每開一個面板往右下偏移 24px，開太多時回捲
    let offsetCounter = 0;

    function nextZIndex(): number {
      zIndexCounter += 1;
      return zIndexCounter;
    }

    function nextOffset(): number {
      const offset = (offsetCounter % 6) * 24;
      offsetCounter += 1;
      return offset;
    }

    // 建立單一面板並插入容器
    function createPanel(work: typeof works[0]): HTMLElement | null {
      if (!panelsContainer) return null;

      const panel = document.createElement('div');
      panel.className = 'work-panel retro-border retro-shadow';
      panel.dataset.workId = String(work.id);
      panel.style.zIndex = String(nextZIndex());

      const offset = nextOffset();
      panel.style.setProperty('--panel-offset', `${offset}px`);

      const categoryLabel = getCategoryLabel(work.category);
      const hasImage = !!work.image;
      const hasLink = !!work.link;
      const hasRelease = !!work.release;

      panel.innerHTML = `
        <div class="work-panel-titlebar">
          <span class="work-panel-title">${work.title}</span>
          <button class="work-panel-close" aria-label="關閉">✕</button>
        </div>
        <div class="work-panel-body">
          ${hasImage ? `
            <div class="work-panel-image-wrap">
              <img src="${work.image}" alt="${work.title}" class="work-panel-image" loading="lazy" />
            </div>
          ` : ''}
          <h2 class="work-panel-heading acid-chroma">${work.title}</h2>
          <p class="work-panel-desc">${work.description}</p>
          <div class="work-panel-tags">
            <span class="work-panel-category">${categoryLabel}</span>
            <span class="work-panel-id font-barcode">#${String(work.id).padStart(3, '0')}</span>
          </div>
          <div class="work-panel-links">
            ${hasLink ? `<a href="${work.link}" target="_blank" rel="noopener noreferrer" class="btn-retro">文本 →</a>` : ''}
            ${hasRelease ? `<a href="${work.release}" target="_blank" rel="noopener noreferrer" class="btn-retro">聆聽 →</a>` : ''}
          </div>
        </div>
      `;

      panelsContainer.appendChild(panel);
      bindPanelEvents(panel);
      return panel;
    }

    // 綁定面板的拖曳、關閉、點擊提升事件
    function bindPanelEvents(panel: HTMLElement) {
      const titlebar = panel.querySelector('.work-panel-titlebar');
      const closeBtn = panel.querySelector('.work-panel-close');

      // 關閉：移除 DOM
      closeBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        panel.remove();
      });

      // 點擊面板任意處提升到最上層
      panel.addEventListener('mousedown', () => {
        panel.style.zIndex = String(nextZIndex());
      });
      panel.addEventListener('touchstart', () => {
        panel.style.zIndex = String(nextZIndex());
      }, { passive: true });

      // 拖曳邏輯（沿用 mini strudel player 的做法）
      let dragOffsetX = 0;
      let dragOffsetY = 0;
      let isDragging = false;

      function startDrag(clientX: number, clientY: number) {
        const rect = panel.getBoundingClientRect();
        dragOffsetX = clientX - rect.left;
        dragOffsetY = clientY - rect.top;
        isDragging = true;
        document.body.style.userSelect = 'none';
        panel.classList.add('is-dragging');
        panel.style.zIndex = String(nextZIndex());
      }

      function doDrag(clientX: number, clientY: number) {
        if (!isDragging) return;
        let newLeft = clientX - dragOffsetX;
        let newTop = clientY - dragOffsetY;
        // 限制在視窗內（不要整個拖出去）
        const maxX = window.innerWidth - panel.offsetWidth;
        const maxY = window.innerHeight - panel.offsetHeight;
        newLeft = Math.max(0, Math.min(newLeft, maxX));
        newTop = Math.max(0, Math.min(newTop, maxY));
        panel.style.left = `${newLeft}px`;
        panel.style.top = `${newTop}px`;
        panel.classList.add('is-positioned');
      }

      function endDrag() {
        isDragging = false;
        document.body.style.userSelect = '';
        panel.classList.remove('is-dragging');
      }

      titlebar?.addEventListener('mousedown', (e) => {
        startDrag(e.clientX, e.clientY);
        e.preventDefault();
      });
      document.addEventListener('mousemove', (e) => doDrag(e.clientX, e.clientY));
      document.addEventListener('mouseup', endDrag);

      titlebar?.addEventListener('touchstart', (e) => {
        if (e.touches.length > 0) {
          startDrag(e.touches[0].clientX, e.touches[0].clientY);
          e.preventDefault();
        }
      }, { passive: false });
      document.addEventListener('touchmove', (e) => {
        if (isDragging && e.touches.length > 0) {
          doDrag(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: false });
      document.addEventListener('touchend', endDrag);
    }

    // 作品卡片點擊 → 開新面板
    document.querySelectorAll('.work-card').forEach((card) => {
      card.addEventListener('click', () => {
        const id = Number((card as HTMLElement).dataset.workId);
        const work = works.find((w) => w.id === id);
        if (work) createPanel(work);
      });
    });

    // ESC 關閉最上層面板
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panelsContainer) {
        const panels = panelsContainer.querySelectorAll<HTMLElement>('.work-panel');
        if (panels.length === 0) return;
        // 找 z-index 最高的面板關閉
        let topPanel: HTMLElement | null = null;
        let topZ = -1;
        panels.forEach((p) => {
          const z = Number(p.style.zIndex || 0);
          if (z > topZ) {
            topZ = z;
            topPanel = p;
          }
        });
        topPanel?.remove();
      }
    });
  </script>
</BaseLayout>
