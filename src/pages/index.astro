---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import MiniStrudelPlayer from '../components/MiniStrudelPlayer.astro';
import WormBakeryTV from '../components/WormBakeryTV.astro';
import Waveform from '../components/Waveform.astro';
---

<BaseLayout title="卡蚯蚓的個人網站" description="卡蚯蚓的個人作品集：寫作、編劇、音聲台本與 VTuber Staff 相關作品。">
  <LoadingScreen />
  <Navigation />

  <!-- Hero Section：卡蚯蚓主視覺 -->
  <section id="hero-section" class="relative min-h-[70vh] flex items-center justify-center overflow-hidden pt-20">
    <div class="relative z-10 text-center px-4">
      <!-- 主視覺圖 -->
      <div class="mb-8 w-full max-w-md mx-auto h-48 md:h-64">
        <img
          src="/pic/卡蚯蚓_去背.png"
          alt="卡蚯蚓的個人圖像"
          class="w-full h-full object-contain acid-chroma-strong hero-kacha-img"
        />
      </div>

      <!-- 品牌大字 -->
      <h1 class="text-6xl md:text-8xl lg:text-9xl font-black mb-6 tracking-tighter acid-chroma hero-kacha-title">
        卡蚯蚓
      </h1>

      <!-- Slogan -->
      <div class="space-y-2 font-mono text-xl md:text-3xl font-bold hero-slogan">
        <p>To find the perfect words.</p>
        <p>To say less but to say more.</p>
      </div>

      <!-- 條碼裝飾 -->
      <div class="mt-8 font-barcode text-4xl tracking-widest opacity-80">
        ・WRITING・SCRIPT・VTUBER・
      </div>

      <!-- Hero 聲波 -->
      <div class="mt-12 flex justify-center">
        <Waveform bars={32} />
      </div>
    </div>

    <!-- Mini Strudel 浮動播放器（可拖曳、可關閉） -->
    <MiniStrudelPlayer boundsId="hero-section" />
  </section>

  <!-- WormBakery TV Gallery：電視轉台檢視合輯 -->
  <WormBakeryTV />

  <Footer />
</BaseLayout>
