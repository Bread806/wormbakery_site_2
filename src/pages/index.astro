---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import StrudelPlayer from '../components/StrudelPlayer.astro';
import Waveform from '../components/Waveform.astro';
import { BRANDS } from '../data/brand';

const brand = BRANDS.kacha; // 預設品牌，腳本會依實際選擇更新
---

<BaseLayout title={brand.metaTitle} description={brand.metaDescription}>
  <LoadingScreen />
  <Navigation />

  <main class="pt-20 pb-16">
    <!-- Hero Section -->
    <section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden bg-grid">
      <div class="relative z-10 text-center px-4">
        <!-- 品牌主視覺圖 -->
        <div id="hero-logo-container" class="mb-8">
          <img
            id="hero-image"
            src={brand.avatar}
            alt={brand.avatarAlt}
            class="mx-auto max-h-[30vh] object-contain acid-chroma-strong"
          />
        </div>

        <!-- 品牌大字 -->
        <h1
          id="hero-title"
          class="text-5xl md:text-7xl lg:text-8xl font-black mb-6 tracking-tighter acid-chroma"
        >
          {brand.heroTitle}
        </h1>

        <!-- Slogan -->
        <div class="space-y-2 font-mono text-lg md:text-2xl">
          <p id="tagline-1">{brand.tagline1}</p>
          <p id="tagline-2">{brand.tagline2}</p>
        </div>

        <!-- 條碼裝飾 -->
        <div class="mt-8 font-barcode text-4xl tracking-widest opacity-80">
          ・WRITING・SCRIPT・VTUBER・
        </div>

        <!-- Hero 聲波 -->
        <div class="mt-12 flex justify-center">
          <Waveform bars={32} />
        </div>
      </div>
    </section>

    <!-- 跑馬燈分隔線 -->
    <div class="border-y-3 border-[var(--fg)] overflow-hidden py-3 my-8">
      <div class="animate-marquee whitespace-nowrap font-mono text-2xl">
        <span class="mx-8">WRITING</span>
        <span class="mx-8">SCRIPT</span>
        <span class="mx-8">AUDIO DRAMA</span>
        <span class="mx-8">VTuber STAFF</span>
        <span class="mx-8">SOUND</span>
        <span class="mx-8">VOICE</span>
        <span class="mx-8">TEXT</span>
        <!-- 重複一次以達到無縫滾動 -->
        <span class="mx-8">WRITING</span>
        <span class="mx-8">SCRIPT</span>
        <span class="mx-8">AUDIO DRAMA</span>
        <span class="mx-8">VTuber STAFF</span>
        <span class="mx-8">SOUND</span>
        <span class="mx-8">VOICE</span>
        <span class="mx-8">TEXT</span>
      </div>
    </div>

    <!-- Strudel 播放器區 -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-4xl font-mono font-bold mb-4 acid-chroma text-center">
        listen to some code
      </h2>
      <StrudelPlayer />
    </section>
  </main>

  <Footer />

  <script>
    import { BRANDS } from '../data/brand';
    import { getBrand, onBrandChange } from '../lib/brandManager';

    const heroTitle = document.getElementById('hero-title');
    const heroImage = document.getElementById('hero-image') as HTMLImageElement | null;
    const tagline1El = document.getElementById('tagline-1');
    const tagline2El = document.getElementById('tagline-2');

    function updateHero(brand: 'kacha' | 'worm') {
      const data = BRANDS[brand];
      if (heroTitle) heroTitle.textContent = data.heroTitle;
      if (heroImage) {
        heroImage.src = data.avatar;
        heroImage.alt = data.avatarAlt;
      }
      if (tagline1El) tagline1El.textContent = data.tagline1;
      if (tagline2El) tagline2El.textContent = data.tagline2;
    }

    updateHero(getBrand());
    onBrandChange(updateHero);
  </script>
</BaseLayout>
