---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const TIMELINE = [
  { year: '2022', events: ['我與充滿包容力的姊姊撒嬌日常', '等待女朋友回家的時候被姊姊給襲擊了', '無法逃離獸人姊姊病嬌的愛'] },
  { year: '2023', events: ['鄉間小路與多愁善感的姐姐', '慾兔', '我們的事'] },
  { year: '2024', events: ['只想要你聽著我', '我才是最特別的納一位', '居酒屋的姊姊似乎討厭下雨天'] },
  { year: '2025', events: ['鼠在不想離開你', 'Love Sick'] },
  { year: '2026', events: ['羞澀的新婚之夜～小雪在你懷中低聲呢喃的愛', '將尾巴與月色借你，直到雪夜放晴', { text: '敬請期待 :D', muted: true }] },
];
---

<BaseLayout title="卡蚯蚓的個人網站" description="卡蚯蚓的個人作品集：寫作、編劇、音聲台本與 VTuber Staff 相關作品。">
  <Navigation />

  <main class="pt-20 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Profile Header -->
      <section class="flex flex-col md:flex-row items-center gap-12 mb-20">
        <div class="relative w-64 h-64 retro-border retro-shadow-lg overflow-hidden flex items-center justify-center bg-[var(--bg)]">
          <img
            src="/pic/shiba.png"
            alt="卡蚯蚓的個人圖像"
            class="max-w-full max-h-full object-contain p-4"
          />
        </div>
        <div class="flex-1 text-center md:text-left">
          <h1 class="text-5xl font-black mb-4 acid-chroma">卡蚯蚓</h1>
          <p class="text-xl font-bold mb-6 opacity-80 font-mono">Writing / VTuber Staff</p>
          <div class="flex flex-wrap gap-3 justify-center md:justify-start">
            <span class="px-4 py-2 border-2 border-[var(--fg)] font-bold">台本設計</span>
            <span class="px-4 py-2 border-2 border-[var(--fg)] font-bold">VTuber窗口</span>
          </div>
        </div>
      </section>

      <!-- 關於我 -->
      <section class="mb-20">
        <h2 class="text-4xl font-mono font-bold mb-8 acid-chroma">關於我</h2>
        <div class="card-retro p-8 space-y-4">
          <p class="text-lg leading-relaxed">我叫做卡蚯蚓，可以稱呼我蚯蚓就好。喜歡寫作與編劇，同時也是喜歡各種聲音表演的聽眾。在網路上發表與撰寫短篇語音、長篇音聲作品與情境劇台本。在這個網站裡，你可以看到我曾參與過的作品。</p>
          <p class="text-lg leading-relaxed">委託會先經過一輪需求討論才會確認是否承接，造成不便請見諒。</p>
        </div>
      </section>

      <!-- 年表 -->
      <section class="mb-20">
        <h2 class="text-4xl font-mono font-bold mb-8 acid-chroma">部分參與作品（年表）</h2>
        <div class="space-y-6">
          {TIMELINE.map((item) => (
            <div class="flex gap-6">
              <div class="font-mono font-bold text-2xl w-20 flex-shrink-0">{item.year}</div>
              <div class="flex-1 border-l-3 border-[var(--fg)] pl-6 space-y-2">
              {item.events.map((event) =>
                typeof event === 'string' ? (
                  <p class="text-lg">{event}</p>
                ) : (
                  <p class="text-lg opacity-40">{event.text}</p>
                )
              )}
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
