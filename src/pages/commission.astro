---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getYearLights, getTaipeiToday, type MonthStatus } from '../lib/notion';

// 自 profile 遷移而來的承接委託事項（內容維持原樣）
const SKILLS = [
  { name: '情境劇', exp: 80, desc: '5~30 分鐘的第一人稱文本。主要以人物對話與台詞呈現劇情，極少音效。' },
  { name: '音聲作品', exp: 88, desc: '長度與尺度彈性，音效與台詞穿插表達故事。' },
  { name: '會員語音', exp: 92, desc: '快節奏的故事，適合 1-5 分鐘的語音內容。' },
  { name: '企劃文本', exp: 85, desc: '適合使用在 ASMR 直播或是個特殊企劃直播的文本。' },
];

const lights = await getYearLights();
const today = getTaipeiToday();

// 兩態燈號：進度條填充（busy 滿、inquire 空），顏色用站內 acid 色票
const STATUS_META: Record<MonthStatus, { label: string; abbr: string; zh: string; light: string; barFill: number; barColor: string }> = {
  inquire: { label: 'INQUIRE', abbr: 'INQ', zh: '可洽詢', light: 'var(--accent-lime)', barFill: 0, barColor: 'var(--accent-lime)' },
  busy: { label: 'BUSY', abbr: 'BSY', zh: '滿檔', light: 'var(--accent-red)', barFill: 100, barColor: 'var(--accent-red)' },
};
const LEGEND_ORDER: MonthStatus[] = ['inquire', 'busy'];

const pad = (n: number): string => String(n).padStart(2, '0');
---

<BaseLayout title="承接委託 | 卡蚯蚓的個人網站" description="卡蚯蚓的承接委託事項，以及依工作紀錄自動更新的年度接單狀態燈號表。">
  <Navigation />

  <main class="pt-20 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- 頁首 -->
      <section class="mb-20">
        <h1 class="text-5xl font-black mb-3 acid-chroma">COMMISSION</h1>
        <p class="text-xl font-bold mb-4 opacity-80 font-mono">承接委託 / 年度接單狀態</p>
        <div class="font-barcode text-3xl opacity-50" aria-hidden="true">commission status {lights.year}</div>
      </section>

      <!-- 區塊一：承接委託事項 -->
      <section class="mb-20">
        <h2 class="text-4xl font-mono font-bold mb-8 acid-chroma">承接委託事項</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {SKILLS.map((skill) => (
            <div class="card-retro p-6">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xl font-bold">{skill.name}</span>
                <span class="font-mono text-sm">{skill.exp}%</span>
              </div>
              <div class="h-3 retro-border overflow-hidden mb-3">
                <div class="h-full bg-[var(--fg)]" style={`width: ${skill.exp}%`}></div>
              </div>
              <p class="text-sm opacity-80">{skill.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 區塊二：年度接單狀態（Windows Form 視窗 + 資料夾 + 進度條） -->
      <section class="mb-20">
        <h2 class="text-4xl font-mono font-bold mb-8 acid-chroma">年度接單狀態 {lights.year}</h2>

        <!-- 圖例：小燈號（綠 = 可洽詢、紅 = 滿檔） -->
        <div class="flex flex-wrap gap-x-8 gap-y-3 mb-10 font-mono text-sm font-bold">
          {LEGEND_ORDER.map((s) => (
            <span class="flex items-center gap-2">
              <span
                class="inline-block w-3.5 h-3.5 border-2 border-[var(--fg)]"
                style={`background-color: ${STATUS_META[s].light}; box-shadow: 0 0 8px 1px ${STATUS_META[s].light};`}
                aria-hidden="true"
              ></span>
              {STATUS_META[s].label}（{STATUS_META[s].zh}）
            </span>
          ))}
        </div>

        <!-- Windows Form 視窗：12 個月份資料夾 + 進度條 -->
        <div class="commission-form retro-border retro-shadow">
          <!-- 標題列：應用程式名 + 視窗控制鈕 -->
          <div class="commission-form-titlebar">
            <span class="commission-form-title">COMMISSION_STATUS_{lights.year}.EXE</span>
            <span class="commission-form-controls" aria-hidden="true">
              <span class="commission-form-btn">_</span>
              <span class="commission-form-btn">▢</span>
              <span class="commission-form-btn">✕</span>
            </span>
          </div>

          <!-- 內容區：一年 12 格資料夾（手機 3 欄、平板 4 欄、桌機 6 欄） -->
          <div class="commission-form-body">
            <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-x-4 gap-y-8 relative z-10">
              {lights.months.map((m) => {
                const isNow = m.month === today.month;
                const isPast = m.month < today.month;
                const meta = STATUS_META[m.status];
                return (
                  <div
                    class={`folder-item retro-hover ${isPast ? 'opacity-60' : ''} ${isNow ? 'is-now' : ''}`}
                    role="img"
                    aria-label={`${lights.year} 年 ${m.month} 月：${meta.label}（${meta.zh}），委託 ${m.count} 件`}
                  >
                    <!-- 資料夾 icon：tab + 本體，月份數字嵌在 tab 上，本體顯示狀態縮寫 -->
                    <div class="folder-icon">
                      <div class="folder-tab">
                        <span class="folder-tab-label">{pad(m.month)}</span>
                      </div>
                      <div class="folder-body">
                        {isNow ? (
                          <pre class="folder-body-ascii" aria-label="NOW">{`>>>\nNOW\n<<<`}</pre>
                        ) : (
                          <span class="folder-body-label">{meta.abbr}</span>
                        )}
                      </div>
                    </div>
                    <!-- 進度條：inquire 空、busy 滿 -->
                    <div class="commission-bar" aria-hidden="true">
                      <div
                        class="commission-bar-fill"
                        style={`width: ${meta.barFill}%; background-color: ${meta.barColor};`}
                      ></div>
                    </div>
                    <!-- 狀態標籤 -->
                    <div class="mt-2 flex items-center justify-between font-mono text-xs">
                      <span class="font-bold">{meta.label}</span>
                    </div>
                    {isNow && (
                      <span class="now-led" aria-label="現在月份" title="NOW"></span>
                    )}
                  </div>
                );
              })}
            </div>
          </div>

          <!-- 狀態列：底部訊息列，呼應 Windows Form 語彙 -->
          <div class="commission-form-statusbar font-mono text-xs">
            <span>STATUS: READY</span>
            <span>LAST SYNC: {lights.syncedAt.slice(0, 10)} UTC</span>
            <span>SOURCE: NOTION WORKLOG</span>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
