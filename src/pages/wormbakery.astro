---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { BRANDS } from '../data/brand';

const worm = BRANDS.worm;
---

<BaseLayout title={worm.metaTitle} description={worm.metaDescription}>
  <Navigation />

  <main class="pt-20 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- 返回主站連結 -->
      <a href="/" class="inline-flex items-center gap-2 mb-8 font-mono text-sm opacity-70 hover:opacity-100 hover:acid-chroma transition-all">
        ← 返回卡蚯蚓主站
      </a>

      <!-- Hero -->
      <section class="text-center mb-12">
        <div class="retro-border retro-shadow-lg inline-block p-8 bg-[var(--bg)] mb-6">
          <img
            src={worm.avatar}
            alt={worm.avatarAlt}
            class="max-w-full max-h-64 object-contain"
          />
        </div>
        <h1 class="text-5xl md:text-6xl font-mono font-black mb-4 acid-chroma">
          {worm.heroTitle}
        </h1>
        <div class="space-y-1 font-mono text-lg opacity-80">
          <p>{worm.tagline1}</p>
          <p>{worm.tagline2}</p>
        </div>
      </section>

      <!-- 介紹 -->
      <section class="card-retro p-8 mb-12 space-y-4">
        <h2 class="text-2xl font-mono font-bold acid-chroma mb-4">關於這個計畫</h2>
        {worm.profileIntro.map((p) => (
          <p class="text-lg leading-relaxed">{p}</p>
        ))}
      </section>

      <!-- Logo 展示區 -->
      <section class="mb-12">
        <h2 class="text-2xl font-mono font-bold mb-6 acid-chroma text-center">標準字與圖示</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="card-retro p-6 text-center">
            <div class="aspect-square retro-border bg-[var(--fg)] p-4 flex items-center justify-center mb-4">
              <img src="/pic/bakery-logo-white.png" alt="白色標準字" class="max-w-full max-h-full object-contain" />
            </div>
            <p class="font-mono text-sm">白色標準字</p>
          </div>
          <div class="card-retro p-6 text-center">
            <div class="aspect-square retro-border bg-[var(--bg)] p-4 flex items-center justify-center mb-4">
              <img src="/pic/bakery-logo-black.png" alt="黑色標準字" class="max-w-full max-h-full object-contain" />
            </div>
            <p class="font-mono text-sm">黑色標準字</p>
          </div>
          <div class="card-retro p-6 text-center md:col-span-2">
            <div class="aspect-[3/1] retro-border bg-[var(--bg)] p-8 flex items-center justify-center mb-4">
              <img src="/pic/bakery-icon.png" alt="麵包屋圖示" class="max-w-full max-h-full object-contain" />
            </div>
            <p class="font-mono text-sm">圖示</p>
          </div>
        </div>
      </section>

      <!-- 聯絡與返回 -->
      <section class="text-center">
        <p class="font-mono mb-4">台本使用與合作聯絡請見</p>
        <a href="/sns" class="btn-retro inline-flex items-center gap-2">
          前往 Official SNS
        </a>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
