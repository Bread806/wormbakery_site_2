---
// 載入畫面：worm-bakery 環狀文字輪 + 進度環 + 中心擴散退場
// 僅在硬刷新（F5 / Ctrl+R）時播放；一般導航直接跳過
---

<div
  id="loading-screen"
  class="fixed inset-0 z-[9999] bg-[var(--bg)] flex items-center justify-center pointer-events-none"
  hidden
  role="status"
  aria-live="polite"
  aria-label="載入中"
>
  <div class="wheel-ring">
    <!-- 進度環：conic-gradient 由 JS 填色 -->
    <div id="wheel-progress" class="wheel-progress"></div>

    <!-- 環狀文字輪：SVG textPath 沿圓排列，外層旋轉 -->
    <div class="wheel-text">
      <svg viewBox="0 0 200 200" class="wheel-svg">
        <defs>
          <!-- 文字貼附的圓形路徑：半徑 80，圓心 (100,100) -->
          <path id="wheel-circle-path" d="M 100,100 m -80,0 a 80,80 0 1,1 160,0 a 80,80 0 1,1 -160,0" fill="none" />
        </defs>
        <text class="wheel-text-content" font-family="monospace" font-weight="bold" font-size="13" letter-spacing="2" fill="var(--fg)">
          <textPath href="#wheel-circle-path" startOffset="0">
            worm — bakery — worm — bakery — worm — bakery —
          </textPath>
        </text>
      </svg>
    </div>

    <!-- 中央輪框 -->
    <div class="wheel-hub"></div>
  </div>
</div>

<style>
  #loading-screen[hidden] { display: none; }
  .wheel-ring {
    position: relative;
    width: 200px;
    height: 200px;
  }
  /* 進度環：conic-gradient 背景由 JS 動態更新；用 mask 挖成 10px 寬的外環 */
  .wheel-progress {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(var(--fg) 0deg, transparent 0deg);
    -webkit-mask: radial-gradient(circle, transparent 90px, #000 92px);
            mask: radial-gradient(circle, transparent 90px, #000 92px);
  }
  /* 環狀文字輪：整個 SVG 旋轉 */
  .wheel-text {
    position: absolute;
    inset: 0;
    animation: wheel-spin 3s linear infinite;
  }
  .wheel-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .wheel-text-content {
    text-transform: uppercase;
  }
  /* 中央輪框：內圓邊框，呼應滑板輪的輪轂 */
  .wheel-hub {
    position: absolute;
    inset: 55px;
    border: 2px solid var(--fg);
    border-radius: 50%;
  }
  @keyframes wheel-spin {
    to { transform: rotate(360deg); }
  }
  /* 短促淡出，避免全螢幕大幅縮放增加重繪成本。 */
  #loading-screen.exiting {
    transform: scale(1.08);
    opacity: 0;
    transition: transform 0.3s ease-out, opacity 0.3s ease-out;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .wheel-text { animation: none; }
  }
</style>

<script is:inline>
  const loadingScreen = document.getElementById('loading-screen');
  const wheelProgress = document.getElementById('wheel-progress');

  if (loadingScreen && wheelProgress) {
    // Navigation Timing API：判斷進入方式
    // reload = F5 / Ctrl+R；navigate = 點連結；back_forward = 回上一頁
    const navEntry = performance.getEntriesByType('navigation')[0];
    const navType = navEntry?.type ?? 'navigate';

    // 只在硬刷新時播放動畫，其餘直接跳過
    if (navType !== 'reload' || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      loadingScreen.remove();
    } else {
      loadingScreen.hidden = false;
      wheelProgress.style.background = 'conic-gradient(var(--fg) 360deg, transparent 360deg)';
      let dismissed = false;
      const dismiss = () => {
        if (dismissed) return;
        dismissed = true;
        loadingScreen.classList.add('exiting');
        setTimeout(() => loadingScreen.remove(), 300);
      };
      // 僅保留短退場：不讓非首屏圖片或外部資源阻擋閱讀。
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', dismiss, { once: true });
      } else {
        dismiss();
      }
      setTimeout(dismiss, 700);
    }
  }
</script>
