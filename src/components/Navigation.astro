---
// 導航列：移除品牌切換器，改為單純導航（麵包屋成為獨立頁面）
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-[var(--bg)]/90 backdrop-blur-sm border-b-3 border-[var(--fg)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo 區：永遠顯示卡蚯蚓 -->
      <a href="/" class="flex items-center gap-3">
        <div class="w-10 h-10 retro-border rounded-full overflow-hidden flex-shrink-0">
          <img
            src="/pic/profile_1.png"
            alt="卡蚯蚓大頭貼"
            class="w-full h-full object-cover"
          />
        </div>
        <span class="font-mono font-bold text-lg hidden sm:inline">卡蚯蚓</span>
        <!-- 小型聲波裝飾 -->
        <div class="hidden md:flex items-end gap-0.5 h-5" aria-hidden="true">
          <div class="w-1 bg-[var(--fg)] animate-blink" style="animation-delay: 0s"></div>
          <div class="w-1 bg-[var(--fg)] animate-blink" style="animation-delay: 0.2s; height: 60%"></div>
          <div class="w-1 bg-[var(--fg)] animate-blink" style="animation-delay: 0.4s; height: 30%"></div>
        </div>
      </a>

      <!-- 導航連結 -->
      <div class="hidden md:flex items-center gap-6">
        <a href="/" class="nav-link font-mono font-bold hover:acid-chroma transition-all" data-page="home">Home</a>
        <a href="/profile" class="nav-link font-mono font-bold hover:acid-chroma transition-all" data-page="profile">Profile</a>
        <a href="/works" class="nav-link font-mono font-bold hover:acid-chroma transition-all" data-page="works">Works</a>
        <a href="/sns" class="nav-link font-mono font-bold hover:acid-chroma transition-all" data-page="sns">Official SNS</a>
        <button
          id="theme-toggle"
          class="p-2 border-2 border-[var(--fg)] hover:bg-[var(--fg)] hover:text-[var(--bg)] transition-colors"
          aria-label="切換亮暗主題"
        >
          <span class="dark:hidden">☀️</span>
          <span class="hidden dark:inline">🌙</span>
        </button>
      </div>

      <!-- 手機漢堡 -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 border-2 border-[var(--fg)] hover:bg-[var(--fg)] hover:text-[var(--bg)]"
        aria-label="開啟選單"
        aria-expanded="false"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- 手機全屏選單 -->
  <div id="mobile-menu" class="hidden md:hidden bg-[var(--bg)] border-b-3 border-[var(--fg)]">
    <div class="px-4 py-6 flex flex-col gap-4">
      <a href="/" class="nav-link-mobile text-2xl font-mono font-bold py-3 border-b-2 border-[var(--border)]" data-page="home">Home</a>
      <a href="/profile" class="nav-link-mobile text-2xl font-mono font-bold py-3 border-b-2 border-[var(--border)]" data-page="profile">Profile</a>
      <a href="/works" class="nav-link-mobile text-2xl font-mono font-bold py-3 border-b-2 border-[var(--border)]" data-page="works">Works</a>
      <a href="/sns" class="nav-link-mobile text-2xl font-mono font-bold py-3 border-b-2 border-[var(--border)]" data-page="sns">Official SNS</a>
      <button
        id="theme-toggle-mobile"
        class="mt-4 px-4 py-3 border-3 border-[var(--fg)] font-mono font-bold hover:bg-[var(--fg)] hover:text-[var(--bg)]"
      >
        切換主題
      </button>
    </div>
  </div>
</nav>

<script>
  // 主題切換
  function toggleTheme() {
    const html = document.documentElement;
    const current = html.dataset.theme as 'light' | 'dark';
    const next = current === 'dark' ? 'light' : 'dark';
    html.dataset.theme = next;
    localStorage.setItem('wormbakery_theme', next);
  }
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

  // 手機選單
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden');
    mobileMenuBtn.setAttribute('aria-expanded', (!isOpen).toString());
  });

  // 高亮當前頁面
  const currentPath = window.location.pathname;
  const pageMap: Record<string, string> = {
    '/': 'home',
    '/profile': 'profile',
    '/profile/': 'profile',
    '/works': 'works',
    '/works/': 'works',
    '/sns': 'sns',
    '/sns/': 'sns',
  };
  const currentPage = pageMap[currentPath] || pageMap[currentPath.replace(/\/$/, '')];
  if (currentPage) {
    document.querySelectorAll(`[data-page="${currentPage}"]`).forEach((el) => {
      (el as HTMLElement).style.textDecoration = 'underline 3px';
      (el as HTMLElement).style.textUnderlineOffset = '6px';
    });
  }

  // 點選手機選單連結後關閉
  document.querySelectorAll('.nav-link-mobile').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .text-accent-pink {
    color: var(--accent-pink);
  }
</style>
