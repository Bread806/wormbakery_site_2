<canvas class="nengan-stars" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.nengan-stars');
  const context = canvas?.getContext('2d', { alpha: true });

  if (canvas && context) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const frameInterval = 1000 / 20;
    const cell = 7;
    const frames = [
      [' + ', '+*+', ' + '],
      ['  .  ', '  *  ', '.***.', '  *  ', '  .  '],
      ['   .   ', '   +   ', '   *   ', '.+***+.', '   *   ', '   +   ', '   .   '],
    ];
    type Star = { x: number; y: number; duration: number; offset: number; cycle: number };
    const stars: Star[] = Array.from({ length: 5 }, (_, index) => ({
      x: 0, y: 0, duration: 3200 + Math.random() * 1600,
      offset: index * 650, cycle: 0,
    }));
    let width = 0;
    let height = 0;
    let frame = 0;
    let lastFrame = 0;
    let origin = performance.now();
    let pausedAt = 0;

    function place(star: Star) {
      const marginX = Math.min(30, width * .2);
      const marginY = Math.min(30, height * .2);
      star.x = marginX + Math.random() * Math.max(0, width - marginX * 2);
      star.y = marginY + Math.random() * Math.max(0, height - marginY * 2);
    }

    function drawGlyph(lines: string[], x: number, y: number, opacity: number) {
      if (!context || opacity <= 0) return;
      context.fillStyle = `rgba(235, 231, 250, ${opacity})`;
      const top = y - (lines.length - 1) * cell / 2;
      lines.forEach((line, row) => context.fillText(line, x, top + row * cell));
    }

    function draw(time: number) {
      if (!context) return;
      context.clearRect(0, 0, width, height);
      context.font = `${cell}px monospace`;
      context.textAlign = 'center';
      context.textBaseline = 'middle';
      const elapsed = time - origin;

      stars.forEach((star) => {
        if (motion.matches) {
          drawGlyph(frames[2], star.x, star.y, .47);
          return;
        }

        const age = elapsed + star.offset;
        const cycle = Math.floor(age / star.duration);
        if (cycle !== star.cycle) {
          star.cycle = cycle;
          place(star);
        }
        const progress = (age % star.duration) / star.duration;
        let size: number;
        if (progress < .12) size = 0;
        else if (progress < .3) size = 1;
        else if (progress < .62) size = 2;
        else if (progress < .78) size = 1;
        else size = 0;
        const opacity = progress < .86 ? .45 + size * .08 : .45 * (1 - (progress - .86) / .14);
        drawGlyph(frames[size], star.x, star.y, opacity);
      });
    }

    function tick(time: number) {
      if (time - lastFrame >= frameInterval) {
        lastFrame = time;
        draw(time);
      }
      frame = requestAnimationFrame(tick);
    }

    function syncAnimation() {
      cancelAnimationFrame(frame);
      frame = 0;
      if (document.hidden || motion.matches) {
        if (document.hidden) pausedAt ||= performance.now();
        else {
          if (pausedAt) origin += performance.now() - pausedAt;
          pausedAt = 0;
          draw(performance.now());
        }
        return;
      }
      if (pausedAt) origin += performance.now() - pausedAt;
      pausedAt = 0;
      lastFrame = 0;
      frame = requestAnimationFrame(tick);
    }

    function resize() {
      if (!canvas || !context) return;
      width = window.innerWidth;
      height = window.innerHeight;
      const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      stars.forEach(place);
      draw(performance.now());
    }

    window.addEventListener('resize', resize, { passive: true });
    document.addEventListener('visibilitychange', syncAnimation);
    motion.addEventListener('change', syncAnimation);
    resize();
    syncAnimation();
  }
</script>

<style>
  .nengan-stars {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
