---
// WormBakery TV Gallery：模仿 109ichiki works category 的電視轉台檢視窗
// - 電視機：滾輪 / 按鈕切換合輯
// - 電視下方：麵包屋 logo、視窗轉場與作品清單
// - 圖片撐滿 + 左上曲目清單 + 右下 windows-form 簡介
import { ALBUMS } from '../data/albums';
import { Image } from 'astro:assets';
import brandLogo from '../../public/pic/bakerylogo.png';
---

<!-- TV 區 -->
<section id="wormbakery-tv" class="tv-section" style={`--tv-scroll-distance: ${ALBUMS.length === 1 ? 24 : (ALBUMS.length - 1) * 60 + 24}vh;`}>
  <!-- Sticky TV 視窗 -->
  <div class="tv-sticky">
    <!-- 電視外框 -->
    <div class="tv-frame retro-border retro-shadow-lg bg-[var(--bg)]">
      <!-- 上方文字標題（無圖片 logo） -->
      <div class="tv-top-bar">
        <p class="tv-wordmark font-mono font-bold text-2xl md:text-3xl tracking-tight acid-chroma">
          RELEASED
        </p>
      </div>

      <!-- 中央：電視螢幕（圖片撐滿 + overlay） -->
      <div class="tv-screen-wrapper">
        <div class="tv-screen retro-border">
          <!-- 當前合輯封面：幾乎填滿 -->
          <div id="tv-cover" class="tv-cover">
            <img id="tv-cover-img" src={ALBUMS[0].coverImage} alt={ALBUMS[0].title} class="tv-cover-img" loading="lazy" decoding="async" />
          </div>

          <!-- CRT 掃描線 -->
          <div class="tv-scanlines" aria-hidden="true"></div>

          <!-- 無訊號雜訊（切換時短暫顯示） -->
          <div id="tv-static" class="tv-static hidden" aria-hidden="true"></div>

          <!-- 左上 overlay：曲目清單 -->
          <div class="tv-overlay-top-left">
            <p class="tv-channel-label font-mono text-xs opacity-90 mb-2">TRACKS</p>
            <ul id="tv-track-list" class="tv-track-list">
              <!-- JS 動態填入當前合輯的曲目 -->
            </ul>
          </div>

          <!-- 右下 overlay：Windows-form 簡介 dialog -->
          <div id="tv-dialog" class="tv-dialog retro-border retro-shadow bg-[var(--bg)]">
            <div class="tv-dialog-titlebar">
              <span id="tv-dialog-title" class="font-mono text-xs font-bold">{ALBUMS[0].id}_{ALBUMS[0].tracks[0].id}.wav</span>
              <button class="tv-dialog-close" aria-label="關閉" disabled>✕</button>
            </div>
            <div class="tv-dialog-body">
              <h4 id="tv-dialog-track-title" class="text-lg font-bold acid-chroma mb-1">{ALBUMS[0].tracks[0].title}</h4>
              <p id="tv-dialog-desc" class="text-xs leading-relaxed mb-2 opacity-90 whitespace-pre-line">
                {ALBUMS[0].tracks[0].description}
              </p>
              <div id="tv-dialog-credits" class="tv-dialog-credits mb-2 hidden">
                <p class="text-xs font-mono opacity-60 mb-0.5">CREDITS</p>
                <ul id="tv-dialog-credits-list" class="text-xs font-mono space-y-0.5"></ul>
              </div>
              <div class="flex flex-wrap gap-1">
                <a id="tv-dialog-release" href={ALBUMS[0].tracks[0].release} target="_blank" rel="noopener noreferrer" class="btn-retro text-xs px-2 py-1">聆聽 →</a>
              </div>
              <div class="tv-dialog-barcode font-barcode text-sm opacity-50 mt-2">
                <span id="tv-dialog-barcode-text">TV.01.{ALBUMS[0].tracks[0].id.toUpperCase()}</span>
              </div>
            </div>
          </div>

          <!-- 電視角落資訊：頻道 + 時間碼 -->
          <div class="tv-corner-info font-mono text-xs">
            <span id="tv-channel" class="tv-channel">CH 01</span>
            <span class="opacity-60 mx-1">|</span>
            <span id="tv-time-code">00:00:00:00</span>
            <span class="opacity-60 mx-1">|</span>
            <span class="tv-play-indicator animate-blink">▶ PLAY</span>
          </div>

          <!-- 電源 LED -->
          <div class="tv-power-led" aria-hidden="true"></div>
        </div>

        <!-- 電視下方：進度條 -->
        <div class="tv-progress-bar">
          {ALBUMS.map((_, i) => (
            <span
              class="tv-progress-segment"
              data-album-index={i}
            />
          ))}
        </div>
      </div>

      <div class="tv-scroll-feedback" aria-hidden="true">
        <span>SCROLL TO CONTINUE ↓</span>
        <span class="tv-scroll-meter"><span id="tv-scroll-progress"></span></span>
      </div>

      <!-- 手機版切換控制（桌面隱藏） -->
      <div class="tv-mobile-controls">
        <button id="tv-prev" class="tv-nav-btn" aria-label="上一張合輯">◀</button>
        <div class="tv-dots">
          {ALBUMS.map((album, i) => (
            <button
              class="tv-dot"
              data-album-index={i}
              aria-label={`切換到 ${album.title}`}
              aria-current={i === 0 ? 'true' : 'false'}
            />
          ))}
        </div>
        <button id="tv-next" class="tv-nav-btn" aria-label="下一張合輯">▶</button>
      </div>
    </div>
  </div>

  <!-- 滾動區域：縮短高度讓瀏覽更順暢 -->
  <div class="tv-scroll-area" aria-hidden="true"></div>
</section>

<!-- 捲動時先由視窗覆蓋，再讓 logo 移至左側並顯示作品清單 -->
<section id="bakery-story" class="bakery-brand" aria-label="蚯蚓麵包屋作品清單">
  <div class="bakery-brand-sticky">
    <div class="bakery-brand-inner">
      <div class="bakery-logo-wrap">
        <Image
          src={brandLogo}
          widths={[225, 450, 900]}
          sizes="(max-width: 768px) 70vw, 450px"
          width={900}
          format="webp"
          loading="lazy"
          alt="蚯蚓麵包屋標準字"
          class="bakery-logo-img acid-chroma-strong"
        />
      </div>
      <div class="bakery-story-copy">
        <p class="bakery-brand-intro">蚯蚓麵包屋是用來記錄愛與成長的地方，希望你喜歡。</p>
        <h2>作品清單</h2>
        <ul>
          <li><a href="https://youtu.be/baFMkvwwa6w" target="_blank" rel="noopener noreferrer">Hacker Senpai</a></li>
          <li class="bakery-work-unreleased">心之所向</li>
        </ul>
      </div>
    </div>
    <div class="bakery-window-transition" aria-hidden="true">
      <div class="bakery-transition-window bakery-transition-window-a"><span>BAKERY.EXE</span><div>LOVE / GROWTH</div></div>
      <div class="bakery-transition-window bakery-transition-window-b"><span>LOADING...</span><div>✳ ✳ ✳</div></div>
      <div class="bakery-transition-window bakery-transition-window-c"><span>ARCHIVE_02</span><div>蚯蚓麵包屋</div></div>
    </div>
  </div>
</section>

<script>
  import { ALBUMS } from '../data/albums';

  let currentAlbumIndex = 0;
  let currentTrackId: string | null = null;
  const mobileQuery = window.matchMedia('(max-width: 768px)');

  const section = document.getElementById('wormbakery-tv');
  const storySection = document.getElementById('bakery-story');
  const storyStaticQuery = window.matchMedia('(max-width: 768px), (prefers-reduced-motion: reduce)');
  const scrollProgress = document.getElementById('tv-scroll-progress');
  const coverImg = document.getElementById('tv-cover-img') as HTMLImageElement;
  const staticOverlay = document.getElementById('tv-static');
  const trackList = document.getElementById('tv-track-list');
  const channelEl = document.getElementById('tv-channel');
  const timeCodeEl = document.getElementById('tv-time-code');
  const dialogTitle = document.getElementById('tv-dialog-title');
  const dialogTrackTitle = document.getElementById('tv-dialog-track-title');
  const dialogDesc = document.getElementById('tv-dialog-desc');
  const dialogCredits = document.getElementById('tv-dialog-credits');
  const dialogCreditsList = document.getElementById('tv-dialog-credits-list');
  const dialogRelease = document.getElementById('tv-dialog-release') as HTMLAnchorElement;
  const dialogBarcode = document.getElementById('tv-dialog-barcode-text');
  const progressSegments = document.querySelectorAll('.tv-progress-segment');
  const dots = document.querySelectorAll('.tv-dot');
  const prevBtn = document.getElementById('tv-prev');
  const nextBtn = document.getElementById('tv-next');

  let frameCount = 0;
  function updateTimeCode() {
    frameCount++;
    const seconds = Math.floor(frameCount / 30);
    const frames = frameCount % 30;
    const minutes = Math.floor(seconds / 60);
    const hours = Math.floor(minutes / 60);
    const pad = (n: number) => String(n).padStart(2, '0');
    if (timeCodeEl) {
      timeCodeEl.textContent = `${pad(hours)}:${pad(minutes % 60)}:${pad(seconds % 60)}:${pad(frames)}`;
    }
  }
  // 不在畫面內時不更新裝飾時間碼，避免閒置 DOM 工作。
  let clock: ReturnType<typeof setInterval> | undefined;
  let visible = false;
  function syncClock() {
    if (clock !== undefined) clearInterval(clock);
    clock = visible && !document.hidden ? setInterval(updateTimeCode, 33) : undefined;
  }
  if (section) new IntersectionObserver(([entry]) => {
    visible = entry.isIntersecting;
    syncClock();
  }).observe(section);
  document.addEventListener('visibilitychange', syncClock);

  function switchAlbum(index: number, trackId?: string) {
    if (index < 0 || index >= ALBUMS.length) return;
    if (index === currentAlbumIndex && currentTrackId !== null && (!trackId || trackId === currentTrackId)) return;

    triggerChannelSwitch();
    currentAlbumIndex = index;
    const album = ALBUMS[index];

    if (coverImg) {
      coverImg.src = album.coverImage;
      coverImg.alt = album.title;
    }
    if (channelEl) {
      channelEl.textContent = `CH ${String(index + 1).padStart(2, '0')}`;
    }
    progressSegments.forEach((seg, i) => {
      (seg as HTMLElement).classList.toggle('active', i === index);
    });
    dots.forEach((dot, i) => {
      (dot as HTMLElement).classList.toggle('active', i === index);
      dot.setAttribute('aria-current', i === index ? 'true' : 'false');
    });

    renderTrackList(album, trackId);
    const track = trackId
      ? album.tracks.find(t => t.id === trackId)
      : album.tracks[0];
    if (track) {
      currentTrackId = track.id;
      updateDialog(album, track);
    }
  }

  function triggerChannelSwitch() {
    if (!staticOverlay) return;
    staticOverlay.classList.remove('hidden');
    setTimeout(() => staticOverlay?.classList.add('hidden'), 150);
  }

  function renderTrackList(album: typeof ALBUMS[0], activeTrackId?: string) {
    if (!trackList) return;
    trackList.innerHTML = '';
    album.tracks.forEach((track) => {
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.className = 'tv-track-item font-mono';
      btn.dataset.trackId = track.id;
      btn.innerHTML = `${track.id}: ${track.title}`;
      if (track.id === activeTrackId || (!activeTrackId && track === album.tracks[0])) {
        btn.classList.add('current');
      }
      btn.addEventListener('click', () => selectTrack(album, track.id));
      li.appendChild(btn);
      trackList.appendChild(li);
    });
  }

  function selectTrack(album: typeof ALBUMS[0], trackId: string) {
    currentTrackId = trackId;
    trackList?.querySelectorAll('.tv-track-item').forEach((btn) => {
      const el = btn as HTMLElement;
      el.classList.toggle('current', el.dataset.trackId === trackId);
    });
    const track = album.tracks.find(t => t.id === trackId);
    if (track) updateDialog(album, track);
  }

  function updateDialog(album: typeof ALBUMS[0], track: typeof ALBUMS[0]['tracks'][0]) {
    if (dialogTitle) dialogTitle.textContent = `${album.id}_${track.id}.wav`;
    if (dialogTrackTitle) dialogTrackTitle.textContent = track.title;
    if (dialogDesc) dialogDesc.textContent = track.description;
    if (dialogBarcode) dialogBarcode.textContent = `TV.${String(ALBUMS.indexOf(album) + 1).padStart(2, '0')}.${track.id.toUpperCase()}`;

    if (track.release) {
      dialogRelease?.classList.remove('hidden');
      dialogRelease.href = track.release;
    } else {
      dialogRelease?.classList.add('hidden');
    }
    if (track.credits && track.credits.length > 0 && dialogCredits && dialogCreditsList) {
      dialogCredits.classList.remove('hidden');
      dialogCreditsList.innerHTML = '';
      track.credits.forEach((c) => {
        const li = document.createElement('li');
        li.textContent = `${c.role}: ${c.name}`;
        dialogCreditsList.appendChild(li);
      });
    } else if (dialogCredits) {
      dialogCredits.classList.add('hidden');
    }
  }

  // 原生捲動保持跟手；以 sticky 的實際行程計算進度，避免多個 observer 同時換台。
  let scheduled = false;
  const clamp = (value: number) => Math.max(0, Math.min(1, value));
  function updateStory() {
    if (!storySection) return;
    if (storyStaticQuery.matches) {
      storySection.style.setProperty('--story-reveal', '1');
      storySection.style.setProperty('--window-opacity', '0');
      storySection.style.setProperty('--story-logo-shift', '0%');
      storySection.style.setProperty('--story-copy-shift', '0rem');
      return;
    }
    const rect = storySection.getBoundingClientRect();
    const distance = Math.max(1, storySection.offsetHeight - window.innerHeight);
    const progress = clamp(-rect.top / distance);
    const covering = clamp((progress - 0.1) / 0.18) * (1 - clamp((progress - 0.38) / 0.18));
    const reveal = clamp((progress - 0.56) / 0.22);
    storySection.style.setProperty('--window-opacity', String(covering));
    storySection.style.setProperty('--story-reveal', String(reveal));
    storySection.style.setProperty('--story-logo-shift', `${(1 - reveal) * 50}%`);
    storySection.style.setProperty('--story-copy-shift', `${(1 - reveal) * 5}rem`);
    storySection.style.setProperty('--window-scale', String(0.8 + covering * 0.2));
  }
  function updateScroll() {
    scheduled = false;
    updateStory();
    if (!section || mobileQuery.matches) return;
    const rect = section.getBoundingClientRect();
    const distance = Math.max(1, section.offsetHeight - window.innerHeight);
    const progress = Math.max(0, Math.min(1, -rect.top / distance));
    if (scrollProgress) scrollProgress.style.transform = `scaleX(${progress})`;
    if (ALBUMS.length > 1) switchAlbum(Math.min(ALBUMS.length - 1, Math.floor(progress * ALBUMS.length)));
  }
  function scheduleScroll() {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(updateScroll);
  }
  window.addEventListener('scroll', scheduleScroll, { passive: true });
  window.addEventListener('resize', scheduleScroll);
  mobileQuery.addEventListener('change', scheduleScroll);
  storyStaticQuery.addEventListener('change', scheduleScroll);

  // 手機：按鈕切換
  prevBtn?.addEventListener('click', () => {
    const newIndex = (currentAlbumIndex - 1 + ALBUMS.length) % ALBUMS.length;
    switchAlbum(newIndex);
  });
  nextBtn?.addEventListener('click', () => {
    const newIndex = (currentAlbumIndex + 1) % ALBUMS.length;
    switchAlbum(newIndex);
  });
  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => switchAlbum(i));
  });

  switchAlbum(0);
  updateScroll();
</script>
