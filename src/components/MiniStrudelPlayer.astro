---
// Mini Strudel Player：Windows-form 風格的浮動迷你播放器
// - 可拖曳（限制在 Hero section 範圍內）
// - 可關閉（✕ 隱藏、方形按鈕重新開啟）
// - 預設可見，位於 Hero 右下角
//
// 使用方式：在父元件中引入，並可透過 `boundsId` prop 指定拖曳邊界元素 ID，
// 或在播放器元素上設置 `data-bounds="your-section-id"` 覆寫預設。
import { SONGS } from '../data/songs';

interface Props {
  boundsId?: string;
}

const { boundsId = 'hero-section' } = Astro.props;
---

<!-- Mini Strudel Player (floating window, absolutely positioned inside Hero) -->
<div
  id="mini-strudel"
  class="mini-strudel retro-border retro-shadow bg-[var(--bg)]"
  data-open="true"
  data-bounds={boundsId}
>
  <!-- Title bar (draggable handle) -->
  <div id="mini-strudel-header" class="mini-strudel-titlebar">
    <span class="mini-strudel-title">NOW_PLAYING.wav</span>
    <button id="mini-strudel-close" class="mini-strudel-close" aria-label="關閉">✕</button>
  </div>

  <!-- Body -->
  <div class="mini-strudel-body">
    <p id="mini-current-title" class="mini-strudel-song">{SONGS[0]?.title ?? ''}</p>
    <div class="mini-strudel-controls">
      <button id="mini-btn-play" class="mini-strudel-btn">▶</button>
      <button id="mini-btn-stop" class="mini-strudel-btn">■</button>
      <select id="mini-song-select" class="mini-strudel-select">
        {SONGS.map((song) => (
          <option value={song.id}>{song.title}</option>
        ))}
      </select>
    </div>
    <div id="mini-play-waveform" class="mini-strudel-waveform hidden">
      {Array.from({ length: 12 }).map((_, i) => (
        <div
          class="waveform-bar mini-wave-bar"
          style={`animation-delay: ${(i * 0.05).toFixed(2)}s;`}
        />
      ))}
    </div>
    <!-- Volume 拉桿 -->
    <div class="mini-strudel-volume">
      <span class="mini-volume-icon">vol</span>
      <input id="mini-volume" class="mini-volume-range" type="range" min="0" max="1" step="0.01" value="1" aria-label="音量" />
    </div>
  </div>
</div>

<!-- Reopen button (absolute inside hero, hidden by default) -->
<button id="mini-strudel-reopen" class="mini-strudel-reopen retro-border retro-shadow" aria-label="開啟音樂播放器">
  <span class="mini-strudel-reopen-icon" aria-hidden="true">▶</span>
</button>

<!-- Import Map：把 @strudel/soundfonts 的裸 import 全部解析回 @strudel/web@1.0.3 的同一個 module instance，
     避免 registerSound 寫入第二份 sound registry（雙 instance 靜默失敗）。 -->
<script type="importmap">
{
  "imports": {
    "@strudel/webaudio": "https://cdn.jsdelivr.net/npm/@strudel/web@1.0.3/dist/index.mjs",
    "@strudel/core": "https://cdn.jsdelivr.net/npm/@strudel/web@1.0.3/dist/index.mjs",
    "sfumato": "https://cdn.jsdelivr.net/npm/sfumato@0.3.0/dist/sfumato.js",
    "soundfont2-esm": "https://cdn.jsdelivr.net/npm/soundfont2-esm@0.6.0/lib/index.js"
  }
}
</script>

<script>
  import { SONGS } from '../data/songs';

  // ---------------------------------------------------------------------------
  // 播放邏輯（移植自 StrudelPlayer.astro，修正執行方式）
  // ---------------------------------------------------------------------------
  let strudelReady = false;
  let currentSongId: string | null = null;
  let isPlaying = false;

  const miniPlayer = document.getElementById('mini-strudel');
  const playBtn = document.getElementById('mini-btn-play');
  const stopBtn = document.getElementById('mini-btn-stop');
  const songSelect = document.getElementById('mini-song-select') as HTMLSelectElement | null;
  const waveform = document.getElementById('mini-play-waveform');
  const currentTitle = document.getElementById('mini-current-title');
  const volumeInput = document.getElementById('mini-volume') as HTMLInputElement | null;

  // 音量狀態：0~1，串接在歌曲 code 尾端（.gain()），播放/調整皆透過 playSong 重新 evaluate
  let currentVolume = 1;

  // @ts-ignore — @strudel/web 的 module 型別未安裝，全部以 any 使用
  type StrudelMod = {
    initStrudel?: () => Promise<void>;
    // 匯出的 evaluate(code, autoPlay=true) 不回傳 pattern（原始碼無 return）
    evaluate?: (code: string, autoPlay?: boolean) => Promise<undefined>;
    hush?: () => void;
    getAudioContext?: () => AudioContext | null;
  };
  let strudelMod: StrudelMod | null = null;

  // 動態載入 Strudel
  async function initStrudel() {
    if (strudelReady) return;
    // Loading UI：首次播放前需要下載 soundfont 音色與底層音訊模組，避免以為卡住
    if (currentTitle) currentTitle.textContent = '音色載入中…';
    try {
      // 必須指向 /dist/index.mjs（ESM）——裸 URL 會解析到 UMD，導致無 named exports
      // 使用 jsDelivr 並 pin 版本，與上方 importmap 中的 URL 保持一致
      // @ts-ignore
      strudelMod = (await import('https://cdn.jsdelivr.net/npm/@strudel/web@1.0.3/dist/index.mjs')) as StrudelMod;
      // @ts-ignore — 註冊 GM 音色與 909 鼓；prebake 會在 DSL 掛載完成後才執行，因此可安全使用 globalThis.samples / registerSound
      await strudelMod?.initStrudel?.({
        // @ts-ignore
        prebake: async () => {
          // 1. dirt-samples：bd/sd/hh/rm 等一般鼓聲（原本就有）
          (globalThis as any).samples?.('github:tidalcycles/dirt-samples');
          // 2. GM 音色：透過 importmap，@strudel/soundfonts 會共用 @strudel/web 的 registerSound
          const soundfonts = (await import(
            // @ts-ignore — CDN 動態匯入，無型別
            'https://cdn.jsdelivr.net/npm/@strudel/soundfonts@1.0.1/dist/index.mjs'
          )) as any;
          soundfonts.registerSoundfonts?.();
          // 3. Roland TR-909：用 samples() 註冊一份 map（key -> url 陣列），這是 superdough 官方
          //    支援格式（與 samples('github:...') 解析後產物一致）；路徑含空格以 encodeURI 編碼
          const smp = (globalThis as any).samples;
          if (typeof smp === 'function') {
            const BASE = 'https://raw.githubusercontent.com/geikha/tidal-drum-machines/main/machines/';
            const url = (p: string) => encodeURI(BASE + p);
            smp({
              '909bd': [url('RolandTR909/rolandtr909-bd/Bassdrum-01.wav')],
              '909sd': [url('RolandTR909/rolandtr909-sd/sd01.wav')],
              '909hh': [url('RolandTR909/rolandtr909-hh/hh01.wav')],
              '909oh': [url('RolandTR909/rolandtr909-oh/Hat Open.wav')],
              '909rim': [url('RolandTR909/rolandtr909-rim/rs01.wav')],
              '909cp': [url('RolandTR909/rolandtr909-cp/Clap.wav')],
            });
          }
        },
      });
      // initStrudel 內部是 async 掛載 DSL 函數到 globalThis，但它本身不 await，
      // 因此要輪詢等待 DSL（以 s() 為代表）就緒
      const deadline = Date.now() + 20000;
      // @ts-ignore
      while (!(globalThis as any).s && Date.now() < deadline) {
        await new Promise((r) => setTimeout(r, 100));
      }
      // @ts-ignore — Strudel 只掛 cpm，未掛 setcpm/setcps；歌曲 code 會用到 setcpm
      const g = globalThis as any;
      if (!g.setcpm && typeof g.cpm === 'function') {
        g.setcpm = g.cpm;
        g.setcps = g.cpm;
      }
      if (!g.s) {
        throw new Error('Strudel DSL 未就緒');
      }
      strudelReady = true;
      // Loading 結束：恢復顯示當前歌曲（若已有曲目選取）
      if (currentSongId) {
        const song = SONGS.find((s) => s.id === currentSongId);
        if (song && currentTitle) currentTitle.textContent = song.title;
      }
    } catch (err) {
      console.error('Strudel 載入失敗：', err);
      if (currentTitle) currentTitle.textContent = '音訊載入失敗';
    }
  }

  function updateUI(songId: string | null, playing: boolean) {
    const song = SONGS.find((s) => s.id === songId);
    if (song && currentTitle) {
      currentTitle.textContent = song.title;
    }
    if (songSelect && songId) {
      songSelect.value = songId;
    }
    if (waveform) {
      waveform.classList.toggle('hidden', !playing);
    }
  }

  async function playSong(songId: string) {
    await initStrudel();
    if (!strudelReady) return;

    const song = SONGS.find((s) => s.id === songId);
    if (!song) return;

    if (isPlaying) {
      strudelMod?.hush?.();
      isPlaying = false;
    }

    currentSongId = songId;
    isPlaying = true;
    updateUI(songId, true);

    try {
      const code = song.code;
      // @ts-ignore — evaluate 為 @strudel/web 的匯出；實際簽名是 evaluate(code, autoPlay=true)，
      // 內部 transpile 後只在 autoPlay 為真時呼叫 .play()，且「沒有 return」——不回傳 pattern
      const evaluate = strudelMod?.evaluate;
      if (typeof evaluate !== 'function') {
        throw new Error('Strudel evaluate 不可用');
      }
      // 音量以「串接在 code 尾端」的方式套用：.gain() 是 transformation，必須在排程前掛上，
      // 且 evaluate 拿不到 pattern 物件，無法播放後再調整。歌曲 code 皆以 stack(...) 運算式結尾，
      // 跨行成員鏈（stack(...)\n.gain(v)）為合法語法，transpiler 會把最後一個運算式轉成 return。
      // 這樣第一次發聲就帶正確音量，避免先大聲再被覆蓋的閃跳。
      const gainValue = Math.max(0, Math.min(1, currentVolume));
      // @ts-ignore — autoPlay=true：由 evaluate 內部對最終 pattern 呼叫 .play()
      await evaluate(`${code}\n.gain(${gainValue})`, true);
    } catch (err) {
      console.error('播放失敗：', err);
      if (currentTitle) currentTitle.textContent = '播放失敗';
      isPlaying = false;
      updateUI(songId, false);
    }
  }

  function stopPlayback() {
    if (!strudelReady) return;
    strudelMod?.hush?.();
    isPlaying = false;
    updateUI(currentSongId, false);
  }

  playBtn?.addEventListener('click', () => {
    if (isPlaying) {
      stopPlayback();
    } else if (currentSongId) {
      playSong(currentSongId);
    } else if (SONGS.length > 0) {
      playSong(SONGS[0].id);
    }
  });

  stopBtn?.addEventListener('click', stopPlayback);

  songSelect?.addEventListener('change', () => {
    const songId = songSelect.value;
    if (songId) playSong(songId);
  });

  // 音量拉桿：strudel 的 .gain() 是 pattern transformation（產生新 pattern，不會即時影響已播放的），
  // 因此要「停止 → 重新 evaluate」才會生效。用防抖避免拖曳中頻繁重載。
  let volumeTimer: ReturnType<typeof setTimeout> | null = null;
  function applyVolume() {
    if (!isPlaying || !currentSongId) return;
    playSong(currentSongId);
  }
  volumeInput?.addEventListener('input', () => {
    currentVolume = Number(volumeInput.value);
    if (volumeTimer) clearTimeout(volumeTimer);
    volumeTimer = setTimeout(applyVolume, 120); // 120ms 防抖
  });
  volumeInput?.addEventListener('change', () => {
    currentVolume = Number(volumeInput.value);
    if (volumeTimer) clearTimeout(volumeTimer);
    applyVolume();
  });

  if (SONGS.length > 0) {
    currentSongId = SONGS[0].id;
    updateUI(SONGS[0].id, false);
  }

  // ---------------------------------------------------------------------------
  // 拖曳邏輯：改用 absolute 定位（以 Hero 為參考容器），限制在 Hero 內
  // ---------------------------------------------------------------------------
  const header = document.getElementById('mini-strudel-header');
  const boundsId = miniPlayer?.dataset.bounds ?? 'hero-section';
  const hero = document.getElementById(boundsId);

  let dragOffsetX = 0;
  let dragOffsetY = 0;
  let isDragging = false;

  // 取得 Hero 邊界（absolute 定位下，參考座標是 Hero 的左上角）
  function getBounds() {
    if (!hero || !miniPlayer) return null;
    const rect = hero.getBoundingClientRect();
    return {
      width: hero.clientWidth,
      height: hero.clientHeight,
      rect,
    };
  }

  // 拖曳開始
  function startDrag(clientX: number, clientY: number) {
    if (!miniPlayer || !hero) return;
    const heroRect = hero.getBoundingClientRect();
    const miniRect = miniPlayer.getBoundingClientRect();
    // 記錄滑鼠在視窗內的偏移
    dragOffsetX = clientX - miniRect.left;
    dragOffsetY = clientY - miniRect.top;
    isDragging = true;
    document.body.style.userSelect = 'none';
  }

  // 拖曳中
  function doDrag(clientX: number, clientY: number) {
    if (!isDragging || !miniPlayer || !hero) return;
    const heroRect = hero.getBoundingClientRect();
    // 計算新位置（相對於 Hero）
    let newLeft = clientX - heroRect.left - dragOffsetX;
    let newTop = clientY - heroRect.top - dragOffsetY;
    // 限制在 Hero 內
    const maxLeft = hero.clientWidth - miniPlayer.offsetWidth;
    const maxTop = hero.clientHeight - miniPlayer.offsetHeight;
    newLeft = Math.max(0, Math.min(newLeft, maxLeft));
    newTop = Math.max(0, Math.min(newTop, maxTop));
    miniPlayer.style.left = `${newLeft}px`;
    miniPlayer.style.top = `${newTop}px`;
    // 清除預設錨點
    miniPlayer.classList.add('is-positioned');
  }

  // 拖曳結束
  function endDrag() {
    isDragging = false;
    document.body.style.userSelect = '';
  }

  // 滑鼠事件
  header?.addEventListener('mousedown', (e) => {
    startDrag(e.clientX, e.clientY);
    e.preventDefault();
  });
  document.addEventListener('mousemove', (e) => doDrag(e.clientX, e.clientY));
  document.addEventListener('mouseup', endDrag);

  // 觸控事件
  header?.addEventListener('touchstart', (e) => {
    if (e.touches.length > 0) {
      startDrag(e.touches[0].clientX, e.touches[0].clientY);
      e.preventDefault();
    }
  }, { passive: false });
  document.addEventListener('touchmove', (e) => {
    if (isDragging && e.touches.length > 0) {
      doDrag(e.touches[0].clientX, e.touches[0].clientY);
      e.preventDefault();
    }
  }, { passive: false });
  document.addEventListener('touchend', endDrag);

  // 視窗縮放時重新夾緊
  window.addEventListener('resize', () => {
    if (!miniPlayer || !hero || !isDragging) return;
    doDrag(
      (miniPlayer.getBoundingClientRect().left + dragOffsetX),
      (miniPlayer.getBoundingClientRect().top + dragOffsetY)
    );
  });

  // ---------------------------------------------------------------------------
  // 關閉 / 重新開啟邏輯
  // ---------------------------------------------------------------------------
  const closeBtn = document.getElementById('mini-strudel-close');
  const reopenBtn = document.getElementById('mini-strudel-reopen');

  function closePlayer() {
    stopPlayback();
    if (miniPlayer) {
      miniPlayer.dataset.open = 'false';
      miniPlayer.classList.add('hidden');
    }
    reopenBtn?.classList.remove('hidden');
  }

  function openPlayer() {
    if (miniPlayer) {
      miniPlayer.dataset.open = 'true';
      miniPlayer.classList.remove('hidden');
    }
    reopenBtn?.classList.add('hidden');
  }

  closeBtn?.addEventListener('click', closePlayer);
  reopenBtn?.addEventListener('click', openPlayer);
</script>

<style is:global>
/* ---------- 13. Mini Strudel Player（浮動迷你播放器） ---------- */
.mini-strudel {
  position: absolute;
  /* 預設位於 Hero 右下角；拖曳後改由 left/top 控制（見 .is-positioned） */
  right: 20px;
  bottom: 20px;
  z-index: 40;
  min-width: 200px;
  max-width: 260px;
  user-select: none;
}

/* JS 開始拖曳/定位後改由 left/top 控制，清除預設錨點避免衝突 */
.mini-strudel.is-positioned {
  right: auto;
  bottom: auto;
}

/* Hero section 需為 position: relative，讓 JS 能正確計算邊界 */
#hero-section {
  position: relative;
}

.mini-strudel-titlebar {
  background: var(--fg);
  color: var(--bg);
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 0.875rem;
  padding: 4px 8px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: move;
  user-select: none;
  letter-spacing: 0.05em;
}

.mini-strudel-close {
  background: var(--fg);
  color: var(--bg);
  border: none;
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 0.875rem;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  padding: 0;
  line-height: 1;
}

.mini-strudel-close:hover {
  background: var(--bg);
  color: var(--fg);
}

.mini-strudel-body {
  padding: 12px;
}

.mini-strudel-song {
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 1rem;
  margin: 0 0 8px 0;
  /* 可搭配 .acid-chroma 產生 RGB 色像差 */
}

.mini-strudel-controls {
  display: flex;
  gap: 8px;
  align-items: center;
}

.mini-strudel-btn {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  color: var(--fg);
  border: 2px solid var(--fg);
  box-shadow: 2px 2px 0 0 var(--fg);
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 0.875rem;
  cursor: pointer;
  user-select: none;
  transition: transform 0.1s step-end, box-shadow 0.1s step-end,
    background-color 0.1s step-end, color 0.1s step-end;
  flex-shrink: 0;
}

.mini-strudel-btn:hover {
  background: var(--fg);
  color: var(--bg);
  transform: translate(-1px, -1px);
  box-shadow: 3px 3px 0 0 var(--fg);
}

.mini-strudel-btn:active {
  transform: translate(0, 0);
  box-shadow: 1px 1px 0 0 var(--fg);
}

.mini-strudel-select {
  flex: 1;
  min-width: 0;
  background: var(--bg);
  color: var(--fg);
  border: 2px solid var(--fg);
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 0.75rem;
  padding: 4px 6px;
  cursor: pointer;
  box-shadow: inset 2px 2px 0 0 rgba(0, 0, 0, 0.1);
}

.mini-strudel-select:focus {
  outline: none;
  background: var(--fg);
  color: var(--bg);
}

.mini-strudel-waveform {
  display: flex;
  align-items: flex-end;
  gap: 2px;
  height: 24px;
  margin-top: 8px;
}

.mini-wave-bar {
  width: 3px;
  /* 繼承 .waveform-bar 的動畫，此處僅覆寫高度 */
  height: 20px;
}

/* Reopen 按鈕：方形硬邊，沿用 retro-border / retro-shadow 語彙。
   不再用圓形 + emoji，改用 mono 字體的 ▶ 符號，跟播放器本身一致。
   position: fixed 讓按鈕永遠貼齊視窗右下角，與 .mini-strudel 預設錨點一致。 */
.mini-strudel-reopen {
  position: absolute;
  right: 20px;
  bottom: 20px;
  z-index: 40;
  width: 36px;
  height: 36px;
  background: var(--bg);
  color: var(--fg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 0.875rem;
  cursor: pointer;
  user-select: none;
  transition: transform 0.1s step-end, box-shadow 0.1s step-end,
    background-color 0.1s step-end, color 0.1s step-end;
}

.mini-strudel-reopen:hover {
  transform: translate(-2px, -2px);
  box-shadow: 6px 6px 0 0 var(--fg);
  background: var(--fg);
  color: var(--bg);
}

.mini-strudel-reopen:active {
  transform: translate(0, 0);
  box-shadow: 2px 2px 0 0 var(--fg);
}

.mini-strudel-reopen-icon {
  line-height: 1;
  letter-spacing: 0;
}

/* 行動裝置：縮小尺寸並微調位置 */
@media (max-width: 768px) {
  .mini-strudel {
    min-width: 160px;
    max-width: 200px;
    right: 12px;
    bottom: 12px;
  }

  .mini-strudel-btn {
    width: 28px;
    height: 28px;
    font-size: 0.75rem;
  }

  .mini-strudel-select {
    font-size: 0.6875rem;
  }

  .mini-strudel-reopen {
    right: 12px;
    bottom: 12px;
    width: 30px;
    height: 30px;
    font-size: 0.75rem;
  }
}

/* 超小螢幕可考慮預設隱藏（取消註解即可） */
/*
@media (max-width: 480px) {
  .mini-strudel {
    display: none;
  }
}
*/
</style>
